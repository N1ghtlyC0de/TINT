IDENTITY_API_PORT=8081
NODE_ENV=development

AUTH_PROVIDER=firebase

JWT_ISSUER=tint-identity
JWT_AUDIENCE=tint:room
JWT_SECRET=dev-secret-change-in-prod
GUEST_TOKEN_TTL_HOURS=4
INVITATION_DEFAULT_TTL_HOURS=24
# TTL del sync-ticket del host para el WebSocket de sync-core (segundos)
SYNC_TICKET_TTL_SECONDS=600

DATABASE_URL=postgres://tint:tint@localhost:5432/tint?sslmode=disable
REDIS_URL=redis://localhost:6379

# Proyecto de Firebase (obligatorio: iss/aud de los ID tokens)
FIREBASE_PROJECT_ID=tint-login
