# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# identity-api (login, salas, invitaciones y sync-tickets)
VITE_IDENTITY_API_URL=http://localhost:8081/api/v1

# Firebase Auth (cliente web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Canal Sync de sync-core (WebSocket)
VITE_SYNC_WS_URL=ws://localhost:8082/ws/sync

# Codificación del Canal Sync: json (por defecto) o msgpack. Con msgpack se pide el
# subprotocolo tint.sync.msgpack; si sync-core no lo acepta, el cliente sigue en JSON.
VITE_SYNC_ENCODING=json

# Vídeo de RESPALDO (MP4/WebM accesible por el navegador). Solo se usa si la sala no
# tiene vídeo asignado en identity-api (GET /rooms/:id/playback devuelve mediaId null).
# Si se deja vacío, el reproductor muestra "Sin video configurado".
VITE_DEMO_VIDEO_URL=
